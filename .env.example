# Canonical public origin. Configure it for Vercel Production.
SITE_URL=

# Fail-closed code default for Search indexing. For a concrete release, show
# claims/legal/crawl/Search Console evidence and ask the user which value to publish.
SEARCH_INDEXING_ENABLED=false

# Enable only when optional marketing tags are actually configured. The
# first-party consent manager remains dormant while no such tags are loaded.
NEXT_PUBLIC_CONSENT_UI_ENABLED=false

# Optional Google tags are fail-closed and ignored outside Vercel Production.
# In production, keep these values consistent, show the consent/tag evidence and
# ask the user which state to publish. GA4 and Ads destination IDs remain inside GTM.
NEXT_PUBLIC_GOOGLE_TAGS_ENABLED=false
NEXT_PUBLIC_GTM_CONTAINER_ID=

# Fail-closed code default for production contact intake. For a concrete release,
# show migration/Resend/preflight evidence and ask the user which value to publish.
LEAD_INTAKE_ENABLED=false

# Fail-closed code default for production attachments. For a concrete release,
# show malware/processor facts and ask the user which value to publish.
# A true value also requires LEAD_INTAKE_ENABLED=true.
LEAD_ATTACHMENTS_ENABLED=false

# Neon PostgreSQL. Use the pooled URL at application runtime and the direct
# URL only for migrations or other operations that cannot use PgBouncer.
# Copy fresh credentials from the Neon dashboard; never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?channel_binding=require&sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require

# Resend notification. Email is a notification channel, not the system of
# record. Keep all credentials server-only.
LEAD_NOTIFICATION_TO=
LEAD_EMAIL_FROM=
RESEND_API_KEY=

# Explicitly authorized live integration test only. Use a controlled synthetic
# recipient; never commit a personal or customer address.
RUN_LIVE_LEAD_TEST=false
LIVE_LEAD_TEST_EMAIL=

# HMAC secret for short-lived private-file download links included in lead
# notifications. Generate at least 32 random bytes; never reuse RESEND_API_KEY.
LEAD_DOWNLOAD_SECRET=

# Private Vercel Blob. Real values are server-only and must never use a
# NEXT_PUBLIC_ prefix. The read-write token is used for local development;
# connected Vercel deployments may authenticate with project-scoped OIDC.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
BLOB_WEBHOOK_PUBLIC_KEY=
CRON_SECRET=
